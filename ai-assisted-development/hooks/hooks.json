{
  "hooks": {
    "SubagentStart": [
      {
        "matcher": "document-reviewer",
        "hooks": [
          {
            "type": "command",
            "command": "python ${CLAUDE_PLUGIN_ROOT}/scripts/agent-lifecycle.py"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "document-reviewer",
        "hooks": [
          {
            "type": "command",
            "command": "python ${CLAUDE_PLUGIN_ROOT}/scripts/agent-lifecycle.py"
          }
        ]
      }
    ]
  }
}
