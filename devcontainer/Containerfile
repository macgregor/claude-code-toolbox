# Isolated Claude Code Development Container
# Base: Red Hat Universal Base Image 9 Minimal
FROM registry.access.redhat.com/ubi9/ubi-minimal:latest

# Version pins for cacheable layers
ARG CLAUDE_CODE_VERSION=2.0.58
ARG GCLOUD_VERSION=509.0.0

# Install system packages
RUN microdnf install -y \
    git \
    make \
    wget \
    jq \
    vim \
    nano \
    python3 \
    less \
    procps-ng \
    sudo \
    tar \
    gzip \
    findutils \
    shadow-utils \
    bash-completion \
    && microdnf clean all

# Install Google Cloud SDK (cacheable - uses version pin)
ARG GCLOUD_VERSION
RUN curl -fsSL "https://dl.google.com/dl/cloudsdk/channels/rapid/downloads/google-cloud-cli-${GCLOUD_VERSION}-linux-x86_64.tar.gz" -o /tmp/gcloud.tar.gz && \
    tar -xzf /tmp/gcloud.tar.gz -C /usr/local && \
    rm /tmp/gcloud.tar.gz && \
    /usr/local/google-cloud-sdk/install.sh --quiet --usage-reporting=false --path-update=false && \
    ln -s /usr/local/google-cloud-sdk/bin/gcloud /usr/local/bin/gcloud && \
    ln -s /usr/local/google-cloud-sdk/bin/gsutil /usr/local/bin/gsutil

# Download Claude Code installer (cacheable - script rarely changes)
ARG CLAUDE_CODE_VERSION
RUN curl -fsSL https://claude.ai/install.sh -o /tmp/install-claude.sh && \
    chmod +x /tmp/install-claude.sh

# Create claude-user with matching UID/GID from host (declared here to avoid invalidating cache above)
ARG HOST_UID=1000
ARG HOST_GID=1000
RUN groupadd -g ${HOST_GID} claude-user && \
    useradd -u ${HOST_UID} -g ${HOST_GID} -m -s /bin/bash claude-user && \
    echo "claude-user ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

# Create directory structure as root, then set ownership
RUN mkdir -p /workspace && \
    chown -R claude-user:claude-user /workspace

# Switch to claude-user for remaining operations
USER claude-user
WORKDIR /home/claude-user

# Install Claude Code as claude-user (uses cached installer script)
ARG CLAUDE_CODE_VERSION
RUN bash /tmp/install-claude.sh ${CLAUDE_CODE_VERSION}

# Copy config files (done late to avoid invalidating Claude Code installation cache)
USER root
COPY config/bashrc /home/claude-user/.bashrc
COPY scripts/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chown claude-user:claude-user /home/claude-user/.bashrc && \
    chmod 644 /home/claude-user/.bashrc && \
    chmod 755 /usr/local/bin/entrypoint.sh
USER claude-user

# Set working directory to workspace
WORKDIR /workspace

# Entrypoint handles config linking and plugin setup
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["/bin/bash"]
